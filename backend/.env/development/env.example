# Copie para `env` (sem extensão) e preencha. O arquivo `env` é ignorado pelo git.
ORACLE_HOST=database
ORACLE_PORT=1521
ORACLE_DATABASE=ORCLPDB1
ORACLE_USER=DEV
ORACLE_PASSWORD=troque-esta-senha
# Gere uma chave aleatória, p.ex.: openssl rand -hex 32
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria
JWT_SIGNING_ALGORITHM=HS256
